rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is user authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: does the user match the record owner
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Helper: is the current user an accepted professional for the client
    function hasActiveClientRelationship(clientId) {
      return exists(/databases/$(database)/documents/client_relationships/$(request.auth.uid + "_" + clientId)) &&
             get(/databases/$(database)/documents/client_relationships/$(request.auth.uid + "_" + clientId)).data.status == "accepted";
    }

    // User metrics: profile, water logs etc
    // Metric document ID is in format: {userId}_profile or {userId}_water
    match /users_metrics/{metricId} {
      allow read: if isAuth() && (
        metricId == request.auth.uid + "_profile" || 
        metricId == request.auth.uid + "_water" ||
        (metricId.endsWith("_profile") && (
          !('privacy' in resource.data) ||
          resource.data.privacy.isPrivate == false ||
          (exists(/databases/$(database)/documents/follows/$(request.auth.uid + "_" + resource.data.userId)) &&
           get(/databases/$(database)/documents/follows/$(request.auth.uid + "_" + resource.data.userId)).data.status == "accepted") ||
          hasActiveClientRelationship(resource.data.userId)
        ))
      );
      allow create: if isAuth() && (
        (metricId == request.auth.uid + "_profile" && (!('role' in request.resource.data) || request.resource.data.role == 'user')) || 
        metricId == request.auth.uid + "_water"
      );
      allow update: if isAuth() && (
        (metricId == request.auth.uid + "_profile" && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || 
        metricId == request.auth.uid + "_water"
      );
      allow delete: if isAuth() && (
        metricId == request.auth.uid + "_profile" || 
        metricId == request.auth.uid + "_water"
      );
    }

    // User ecosystem state
    match /users_ecosystem/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Log items containing userId field
    match /food_logs/{logId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || hasActiveClientRelationship(resource.data.userId));
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    match /workout_logs/{logId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || hasActiveClientRelationship(resource.data.userId));
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    match /weight_logs/{logId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || hasActiveClientRelationship(resource.data.userId));
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    match /meal_scans/{logId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || hasActiveClientRelationship(resource.data.userId));
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // Chat sessions: keyed by session ID, contains userId
    match /chat_sessions/{sessionId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // AI Coaching feedback training logs
    match /TrainingLogs/{logId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // Social usernames collection
    match /usernames/{username} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Social follow system
    match /follows/{followId} {
      allow read: if isAuth() && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.followerId == request.auth.uid;
      allow update: if isAuth() && resource.data.followingId == request.auth.uid && request.resource.data.status == "accepted";
      allow delete: if isAuth() && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);
    }

    // Social blocking system
    match /blocks/{blockId} {
      allow read: if isAuth() && resource.data.blockerId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.blockerId == request.auth.uid;
    }

    // Social activity feed items
    match /social_activities/{activityId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || 
        (exists(/databases/$(database)/documents/follows/$(request.auth.uid + "_" + resource.data.userId)) &&
         get(/databases/$(database)/documents/follows/$(request.auth.uid + "_" + resource.data.userId)).data.status == "accepted") ||
        hasActiveClientRelationship(resource.data.userId)
      );
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // --- Relationship Ecosystem ---

    // gyms
    match /gyms/{gymId} {
      allow read: if isAuth(); 
      allow create: if isAuth(); 
      allow update, delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // gym_staff
    match /gym_staff/{staffDocId} {
      allow read: if isAuth() && (
        resource.data.staffId == request.auth.uid ||
        get(/databases/$(database)/documents/gyms/$(resource.data.gymId)).data.ownerId == request.auth.uid
      );
      allow create: if isAuth() && get(/databases/$(database)/documents/gyms/$(request.resource.data.gymId)).data.ownerId == request.auth.uid;
      allow update: if isAuth() && resource.data.staffId == request.auth.uid && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if isAuth() && (
        resource.data.staffId == request.auth.uid ||
        get(/databases/$(database)/documents/gyms/$(resource.data.gymId)).data.ownerId == request.auth.uid
      );
    }

    // client_relationships
    match /client_relationships/{relId} {
      allow read: if isAuth() && (resource.data.professionalId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if isAuth() && (request.resource.data.initiatedBy == request.auth.uid);
      allow update: if isAuth() && (
        (resource.data.clientId == request.auth.uid && request.resource.data.status in ['accepted', 'declined']) ||
        (resource.data.professionalId == request.auth.uid && request.resource.data.status in ['accepted', 'declined'])
      );
      allow delete: if isAuth() && (resource.data.professionalId == request.auth.uid || resource.data.clientId == request.auth.uid);
    }
  }
}
