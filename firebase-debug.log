[debug] [2026-07-14T11:05:12.354Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-no-project:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper: is user authenticated\n    function isAuth() {\n      return request.auth != null;\n    }\n\n    // Helper: does the user match the record owner\n    function isOwner(userId) {\n      return isAuth() && request.auth.uid == userId;\n    }\n\n    // Helper: is the current user an accepted professional for the client\n    function hasActiveClientRelationship(clientId) {\n      return exists(/databases/$(database)/documents/client_relationships/$(request.auth.uid + \"_\" + clientId)) &&\n             get(/databases/$(database)/documents/client_relationships/$(request.auth.uid + \"_\" + clientId)).data.status == \"accepted\";\n    }\n\n    // User metrics: profile, water logs etc\n    // Metric document ID is in format: {userId}_profile or {userId}_water\n    match /users_metrics/{metricId} {\n      allow read: if isAuth() && (\n        metricId == request.auth.uid + \"_profile\" || \n        metricId == request.auth.uid + \"_water\" ||\n        (metricId.endsWith(\"_profile\") && (\n          !('privacy' in resource.data) ||\n          resource.data.privacy.isPrivate == false ||\n          (exists(/databases/$(database)/documents/follows/$(request.auth.uid + \"_\" + resource.data.userId)) &&\n           get(/databases/$(database)/documents/follows/$(request.auth.uid + \"_\" + resource.data.userId)).data.status == \"accepted\") ||\n          hasActiveClientRelationship(resource.data.userId)\n        ))\n      );\n      allow create: if isAuth() && (\n        (metricId == request.auth.uid + \"_profile\" && (!('role' in request.resource.data) || request.resource.data.role == 'user')) || \n        metricId == request.auth.uid + \"_water\"\n      );\n      allow update: if isAuth() && (\n        (metricId == request.auth.uid + \"_profile\" && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || \n        metricId == request.auth.uid + \"_water\"\n      );\n      allow delete: if isAuth() && (\n        metricId == request.auth.uid + \"_profile\" || \n        metricId == request.auth.uid + \"_water\"\n      );\n    }\n\n    // User ecosystem state\n    match /users_ecosystem/{userId} {\n      allow read, write: if isOwner(userId);\n    }\n\n    // Log items containing userId field\n    match /food_logs/{logId} {\n      allow read: if isAuth() && (resource.data.userId == request.auth.uid || hasActiveClientRelationship(resource.data.userId));\n      allow delete: if isAuth() && resource.data.userId == request.auth.uid;\n      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;\n    }\n\n    match /workout_logs/{logId} {\n      allow read: if isAuth() && (resource.data.userId == request.auth.uid || hasActiveClientRelationship(resource.data.userId));\n      allow delete: if isAuth() && resource.data.userId == request.auth.uid;\n      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;\n    }\n\n    match /weight_logs/{logId} {\n      allow read: if isAuth() && (resource.data.userId == request.auth.uid || hasActiveClientRelationship(resource.data.userId));\n      allow delete: if isAuth() && resource.data.userId == request.auth.uid;\n      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;\n    }\n\n    match /meal_scans/{logId} {\n      allow read: if isAuth() && (resource.data.userId == request.auth.uid || hasActiveClientRelationship(resource.data.userId));\n      allow delete: if isAuth() && resource.data.userId == request.auth.uid;\n      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;\n    }\n\n    // Chat sessions: keyed by session ID, contains userId\n    match /chat_sessions/{sessionId} {\n      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;\n      allow create, update: if isAuth() && request.resource.data.userId == request.auth.uid;\n    }\n\n    // AI Coaching feedback training logs\n    match /TrainingLogs/{logId} {\n      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;\n      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;\n    }\n\n    // Social usernames collection\n    match /usernames/{username} {\n      allow read: if isAuth();\n      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;\n      allow delete: if isAuth() && resource.data.userId == request.auth.uid;\n    }\n\n    // Social follow system\n    match /follows/{followId} {\n      allow read: if isAuth() && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);\n      allow create: if isAuth() && request.resource.data.followerId == request.auth.uid;\n      allow update: if isAuth() && resource.data.followingId == request.auth.uid && request.resource.data.status == \"accepted\";\n      allow delete: if isAuth() && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);\n    }\n\n    // Social blocking system\n    match /blocks/{blockId} {\n      allow read: if isAuth() && resource.data.blockerId == request.auth.uid;\n      allow create: if isAuth() && request.resource.data.blockerId == request.auth.uid;\n      allow delete: if isAuth() && resource.data.blockerId == request.auth.uid;\n    }\n\n    // Social activity feed items\n    match /social_activities/{activityId} {\n      allow read: if isAuth() && (\n        resource.data.userId == request.auth.uid || \n        (exists(/databases/$(database)/documents/follows/$(request.auth.uid + \"_\" + resource.data.userId)) &&\n         get(/databases/$(database)/documents/follows/$(request.auth.uid + \"_\" + resource.data.userId)).data.status == \"accepted\") ||\n        hasActiveClientRelationship(resource.data.userId)\n      );\n      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;\n      allow delete: if isAuth() && resource.data.userId == request.auth.uid;\n    }\n\n    // --- Relationship Ecosystem ---\n\n    // gyms\n    match /gyms/{gymId} {\n      allow read: if isAuth(); \n      allow create: if isAuth(); \n      allow update, delete: if isAuth() && resource.data.ownerId == request.auth.uid;\n    }\n\n    // gym_staff\n    match /gym_staff/{staffDocId} {\n      allow read: if isAuth() && (\n        resource.data.staffId == request.auth.uid ||\n        get(/databases/$(database)/documents/gyms/$(resource.data.gymId)).data.ownerId == request.auth.uid\n      );\n      allow create: if isAuth() && get(/databases/$(database)/documents/gyms/$(request.resource.data.gymId)).data.ownerId == request.auth.uid;\n      allow update: if isAuth() && resource.data.staffId == request.auth.uid && request.resource.data.status in ['accepted', 'declined'];\n      allow delete: if isAuth() && (\n        resource.data.staffId == request.auth.uid ||\n        get(/databases/$(database)/documents/gyms/$(resource.data.gymId)).data.ownerId == request.auth.uid\n      );\n    }\n\n    // client_relationships\n    match /client_relationships/{relId} {\n      allow read: if isAuth() && (resource.data.professionalId == request.auth.uid || resource.data.clientId == request.auth.uid);\n      allow create: if isAuth() && (request.resource.data.initiatedBy == request.auth.uid);\n      allow update: if isAuth() && (\n        (resource.data.clientId == request.auth.uid && request.resource.data.status in ['accepted', 'declined']) ||\n        (resource.data.professionalId == request.auth.uid && request.resource.data.status in ['accepted', 'declined'])\n      );\n      allow delete: if isAuth() && (resource.data.professionalId == request.auth.uid || resource.data.clientId == request.auth.uid);\n    }\n  }\n}\n"}]}}
